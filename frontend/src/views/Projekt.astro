---
/**
 * Projektoldal mindkét nyelvre (pages/munkak/[slug].astro és pages/en/work/[slug].astro adja a nyelvet és a slugot).
 * Megkeresi a projektet és a saját csoportjában (iskolai vagy rendes munka) a sorban következőt (a lista végén nincs), és a Layout-ba tett
 * CaseStudy komponenssel rajzolja ki.
 * Felújított oldalnál az előtte / utána csúszka szigetként (client:visible) kerül a CaseStudy-ba.
 */
import Layout from "../layouts/Layout.astro";
import { CaseStudy } from "./CaseStudy.tsx";
import { BeforeAfter } from "../components/ui/BeforeAfter.tsx";
import { caseStudies } from "../content/projects.ts";
import { caseStudyJsonLd, OWNER } from "../content/site.ts";
import { messages, paths, type Lang } from "../i18n/index.ts";

const { lang, slug } = Astro.props as { lang: Lang; slug: string };
const t = messages(lang);
const all = await caseStudies();
const project = all.find((item) => item.slug === slug)!;
// A „Következő projekt” csak a saját csoportban lép tovább (iskolai projektről iskolaira, rendes munkáról rendesre),
// és a lista végén megáll: az utolsónál nincs következő, helyette a CaseStudy a lista szekciójába visz vissza.
const list = all.filter((item) => Boolean(item.school) === Boolean(project.school));
const next = list[list.indexOf(project) + 1];
const jsonLd = caseStudyJsonLd(lang, Astro.site!, new URL(Astro.url.pathname, Astro.site).href, project, OWNER.name[lang]);
---

<Layout
  lang={lang}
  title={`${project.title} – ${t.work.caseStudy} | ${OWNER.name[lang]}`}
  description={project.summary[lang]}
  alternates={{ hu: paths("hu").project(slug), en: paths("en").project(slug) }}
  jsonLd={jsonLd}
>
  <CaseStudy project={project} lang={lang} next={next}>
    {project.comparison && <BeforeAfter client:visible comparison={project.comparison} lang={lang} />}
  </CaseStudy>
</Layout>
