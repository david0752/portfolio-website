---
/**
 * Kezdőlap mindkét nyelvre (pages/index.astro és pages/en/index.astro adja a nyelvet):
 * Hero, Munkák, Rólam, Tapasztalat, Stack, Kapcsolat. Csak a kapcsolati űrlap React-sziget,
 * és az is csak akkor töltődik be, amikor a látogató odagörget (client:visible).
 * Itt készül a kezdőlap strukturált adata is (JSON-LD: személy, weboldal, profilok).
 */
import Layout from "../layouts/Layout.astro";
import { Hero } from "../components/Hero.tsx";
import { Kapcsolat } from "../components/Kapcsolat.tsx";
import { Munkak } from "../components/Munkak.tsx";
import { Rolam } from "../components/Rolam.tsx";
import { Stack } from "../components/Stack.tsx";
import { Tapasztalat } from "../components/Tapasztalat.tsx";
import { ContactForm } from "../components/ui/ContactForm.tsx";
import { allProjects } from "../content/projects.ts";
import { profileJsonLd } from "../content/site.ts";
import { messages, paths, type Lang } from "../i18n/index.ts";

const { lang } = Astro.props as { lang: Lang };
const t = messages(lang);
const site = Astro.site!;

// Élesben csak a valódi projektek, fejlesztői módban a példakártyák is (allProjects).
const projects = await allProjects();
const jsonLd = profileJsonLd(lang, site, new URL(Astro.url.pathname, site).href, t.hero.role, t.descriptions.home);
---

<Layout
  lang={lang}
  title={t.pageTitles.home}
  description={t.descriptions.home}
  alternates={{ hu: paths("hu").home, en: paths("en").home }}
  jsonLd={jsonLd}
>
  <Hero lang={lang} />
  <Munkak lang={lang} projects={projects} />
  <Rolam lang={lang} />
  <Tapasztalat lang={lang} />
  <Stack lang={lang} />
  <Kapcsolat lang={lang}>
    <ContactForm client:visible lang={lang} />
  </Kapcsolat>
</Layout>
