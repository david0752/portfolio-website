---
/**
 * Közös keret minden oldalhoz: <head> (cím, leírás, canonical, nyelvi változatok, megosztási adatok,
 * strukturált adat), ugró link, navbar, tartalom, lábléc.
 * A navbar az egyetlen mindig betöltődő React-sziget; a többi komponens statikus HTML.
 * Az egérkövető fény (scripts/pointer.ts), a görgetési beúszás (scripts/reveal.ts) és a főcím szóváltása
 * (scripts/typewriter.ts) sima script, React nélkül.
 * Töltőképernyő: amíg ezek a scriptek és a betűtípus meg nem érkeznek, egy forgó ív takarja az oldalt, így lassú
 * hálózaton sem látszik félkész tartalom (a beúszó elemek addig rejtve vannak). JavaScript nélkül nem jelenik meg,
 * és csak nagy képernyőn mozgással, mert csak ott rejt el bármit a beúszás.
 */
import "../index.css";
import { Footer } from "../components/layout/Footer.tsx";
import { Navbar } from "../components/layout/Navbar.tsx";
import { OWNER } from "../content/site.ts";
import { messages, type Lang } from "../i18n/index.ts";

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  // Ugyanennek az oldalnak a két nyelvi változata (nyelvváltó és hreflang).
  alternates: Record<Lang, string>;
  // 404-es oldalaknál: a keresők ne indexeljék.
  noindex?: boolean;
  // Strukturált adat (JSON-LD) a keresőknek, ha az oldalnak van.
  jsonLd?: object;
}

const { lang, title, description, alternates, noindex = false, jsonLd } = Astro.props;
const t = messages(lang);

// Abszolút címek: a domain az astro.config `site` értéke (frontend/.env SITE_URL).
const abs = (path: string) => new URL(path, Astro.site).href;
const canonical = abs(Astro.url.pathname);
const ogImage = abs(`/og-${lang}.png`);
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#070b14" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonical} />
          <link rel="alternate" hreflang="hu" href={abs(alternates.hu)} />
          <link rel="alternate" hreflang="en" href={abs(alternates.en)} />
          <link rel="alternate" hreflang="x-default" href={abs(alternates.hu)} />
        </>
      )
    }

    <!-- Megosztási előnézet (Facebook, Messenger, LinkedIn, X stb.). -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={OWNER.name[lang]} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === "hu" ? "hu_HU" : "en_US"} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}

    <!-- A görgetési animáció csak akkor rejt el bármit, ha fut a JavaScript (index.css: .js [data-reveal]). -->
    <script is:inline>
      document.documentElement.classList.add("js");
      // Vészfék: ha egy script nem érkezik meg, a töltőképernyő 8 mp után akkor is eltűnik.
      setTimeout(() => document.documentElement.classList.add("is-ready"), 8000);
    </script>
    <!-- A töltőképernyő stílusa itt, a head-ben van, hogy az első képkockától látszódjon (színek: DESIGN.md). -->
    <style is:inline>
      .page-loader {
        display: none;
      }
      /* Csak ott kell, ahol a beúszó elemek a scriptig rejtve vannak (index.css: lg-től, mozgással). Telefonon
       * minden rögtön látszik, ott a takarás csak késleltetné a tartalmat (mobil LCP). */
      @media (min-width: 1024px) and (prefers-reduced-motion: no-preference) {
        .js .page-loader {
          position: fixed;
          inset: 0;
          z-index: 100;
          display: grid;
          place-items: center;
          background: #070b14;
          transition:
            opacity 0.4s ease,
            visibility 0.4s;
        }
        .js:not(.is-ready) body {
          overflow: hidden;
        }
      }
      .is-ready .page-loader {
        opacity: 0;
        visibility: hidden;
        pointer-events: none;
      }
      /* Forgó ív halvány kör alapon: az ív hossza közben nő és fogy. Gyors betöltésnél ne villanjon fel,
       * ezért csak egy rövid szünet után úszik be. */
      .page-loader-spinner {
        width: 44px;
        height: 44px;
        animation:
          loader-in 0.5s ease 0.2s both,
          loader-rotate 1.6s linear infinite;
      }
      .page-loader-spinner circle {
        fill: none;
        stroke-width: 2.5;
      }
      .page-loader-track {
        stroke: #1c2a44;
      }
      .page-loader-arc {
        stroke: #5b9bff;
        stroke-linecap: round;
        stroke-dasharray: 1 150;
        animation: loader-dash 1.6s ease-in-out infinite;
      }
      @keyframes loader-in {
        from {
          opacity: 0;
        }
      }
      @keyframes loader-rotate {
        to {
          transform: rotate(360deg);
        }
      }
      @keyframes loader-dash {
        0% {
          stroke-dasharray: 1 150;
          stroke-dashoffset: 0;
        }
        50% {
          stroke-dasharray: 70 150;
          stroke-dashoffset: -20;
        }
        100% {
          stroke-dasharray: 70 150;
          stroke-dashoffset: -94;
        }
      }
      @media (prefers-reduced-motion: reduce) {
        .page-loader-spinner,
        .page-loader-arc {
          animation: none;
        }
        .page-loader-arc {
          stroke-dasharray: 40 150;
        }
      }
    </style>
  </head>
  <body>
    <div class="page-loader" role="status" aria-live="polite">
      <svg class="page-loader-spinner" viewBox="0 0 50 50" aria-hidden="true">
        <circle class="page-loader-track" cx="25" cy="25" r="20" />
        <circle class="page-loader-arc" cx="25" cy="25" r="20" />
      </svg>
      <span class="sr-only">{t.nav.loading}</span>
    </div>
    <div class="flex min-h-dvh flex-col">
      <a
        href="#tartalom"
        class="sr-only z-50 rounded-lg bg-signal-blue px-4 py-2 text-midnight focus:not-sr-only focus:fixed focus:top-3 focus:left-3"
      >
        {t.nav.skip}
      </a>
      <Navbar client:load lang={lang} alternates={alternates} />
      <main id="tartalom" class="flex-1">
        <slot />
      </main>
      <Footer lang={lang} />
    </div>
    <script>
      import "../scripts/pointer.ts";
      import "../scripts/reveal.ts";
      import "../scripts/typewriter.ts";
      import "../scripts/hscroll.ts";
      import "../scripts/copy.ts";

      // Minden script lefutott: a betűtípusra még legfeljebb 1,5 mp-et várunk, aztán eltűnik a töltőképernyő.
      const fontsReady = Promise.race([document.fonts.ready, new Promise((resolve) => setTimeout(resolve, 1500))]);
      void fontsReady.then(() => document.documentElement.classList.add("is-ready"));
    </script>
  </body>
</html>
