---
// Útvonal: /adatvedelem – magyar adatvédelmi tájékoztató (angolul: /en/privacy).
import Layout from "../layouts/Layout.astro";
import { Adatvedelem } from "../components/Adatvedelem.tsx";
import { messages, paths } from "../i18n/index.ts";

const t = messages("hu");
---

<Layout lang="hu" title={t.pageTitles.privacy} description={t.descriptions.privacy} alternates={{ hu: paths("hu").privacy, en: paths("en").privacy }}>
  <Adatvedelem lang="hu" />
</Layout>
