// Cloudflare Worker: az éles oldal (szdavid.dev) egyetlen projektként fut.
// - A statikus oldalt a frontend buildje adja (../frontend/dist), ezt a Cloudflare közvetlenül szolgálja ki.
// - A Workerig (src/worker.ts) csak az /api/* kérések (kapcsolati űrlap) és a magyar oldalak jutnak el: utóbbiaknál
//   a nem magyar böngészőt az angol párra irányítja, különben továbbadja a statikus oldalt (ASSETS) biztonsági fejlécekkel.
// - A levél a Cloudflare saját levélküldőjével megy, fixen a tulajdonos megerősített címére (Email Routing).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Egyezzen a Cloudflare-en létrehozott Worker projekt nevével, különben a build hibát ad.
  "name": "portfolio-website",
  "main": "src/worker.ts",
  "compatibility_date": "2026-11-01",
  "assets": {
    "directory": "../frontend/dist",
    // Nem létező címre a saját 404-es oldal jön (dist/404.html).
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    // A magyar oldalak (kezdőlap, adatvédelem, munkák) a nyelvi átirányítás miatt; az angol oldalak és a fájlok nem.
    "run_worker_first": ["/api/*", "/", "/adatvedelem", "/adatvedelem/", "/munkak", "/munkak/*"],
  },
  "routes": [{ "pattern": "szdavid.dev", "custom_domain": true }],
  // Csak a saját domainen legyen elérhető: se *.workers.dev cím, se verziónkénti előnézeti cím
  // (fölösleges plusz bejárat lenne, és duplikált tartalom a keresőknek).
  "workers_dev": false,
  "preview_urls": false,
  "send_email": [
    {
      "name": "CONTACT_MAIL",
      // Csak erre az egy címre tud küldeni, akkor is, ha a kód hibás lenne.
      "destination_address": "szanto.david12@gmail.com",
    },
  ],
  // Spam ellen: IP-címenként legfeljebb 2 üzenet percenként (a Cloudflare csak 10 vagy 60 mp-es ablakot ismer).
  "ratelimits": [{ "name": "CONTACT_LIMITER", "namespace_id": "1001", "simple": { "limit": 2, "period": 60 } }],
  "vars": {
    // A levél feladója; a domainnek a Cloudflare Email Routingban kell lennie.
    "MAIL_FROM": "urlap@szdavid.dev",
    // A címzett: ugyanaz, mint a send_email destination_address (a binding más címre nem is engedne).
    "MAIL_TO": "szanto.david12@gmail.com",
  },
  // Csak a saját naplósoraink (hiba neve/kódja) maradnak meg. Az automatikus kérésnapló ki van kapcsolva,
  // mert az minden űrlapküldésnél eltárolná a fejléceket, köztük a küldő IP-címét (adatvédelmi tájékoztató).
  "observability": { "enabled": true, "logs": { "invocation_logs": false } },
}
