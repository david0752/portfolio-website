# A frontend címe: csak innen hívható az API böngészőből (CORS).
FRONTEND_ORIGIN=http://localhost:5173

# nginx mögött 1 (hogy a rate limit a valódi látogatói IP-t lássa); helyben hagyd üresen.
TRUST_PROXY=

# E-mail küldés (Gmail: smtp.gmail.com, 465, a fiók címe és egy alkalmazásjelszó).
# Ha nincs kitöltve, az űrlap 503-as hibát ad, és a látogató az e-mail-címet kapja helyette.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# Ide érkeznek az űrlap üzenetei.
CONTACT_TO=szanto.david12@gmail.com
